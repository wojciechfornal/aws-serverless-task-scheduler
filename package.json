{
  "name": "aws-serverless-task-scheduler",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "build": "pnpm clean && tsc",
    "dev": "node -C development --watch ./src/index.ts",
    "clean": "rm -rf ./dist",
    "start": "node ./dist/index.js",
    "test": "node -C development --test && pnpm typecheck",
    "typecheck": "tsc --noEmit && tsc -p test --noEmit"
  },
  "imports": {
    "#*": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "#/*": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "#src/*": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.23.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.23.0",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "^6.3.0",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.12.7"
  }
}